// 3. 将引脚配置应用到 I2C0 控制器
// 找到你的 I2C0 控制器节点（通常是 i2c@e0004000），并添加 pinctrl 引用。
//&i2c0 { // 使用控制器节点的标签
//    status = "okay";
//    clock-frequency = <100000>; // 设置 I2C 总线频率为 100kHz
//    pinctrl-names = "default";  // 状态名称
//    pinctrl-0 = <&pinctrl_i2c0_default>; // 引用上面定义的引脚配置
    // ... 其他配置，如从设备地址等
//};

&i2c0 {
	clock-frequency = <100000>;

    ov9282: camera@60 {
        compatible = "ovti,ov9282";
        reg = <0x60>;
        /* Use 64MHz XCLK for OV9282 DVP operation */
        clocks = <&cam_clk_24mhz>;
        clock-names = "xclk";
        /* Supply property names expected by many OV sensors/drivers */
        dovdd-supply = <&ov9282_dovdd_2v8>;  // 数字I/O：2.8V
        avdd-supply = <&ov9282_avdd_2v8>;    // 模拟电压：2.8V
        dvdd-supply = <&ov9282_dvdd_1v5>;    // 数字核心：1.5V
        port {
            camera_out: endpoint {
                remote-endpoint = <&vcap_in>;
                bus-type    = <5>;
                /* DVP 10-bit */
                bus-width   = <10>;
                /* Keep signal polarities and sample edge as before */
                hsync-active = <0>;
                vsync-active = <0>;
                pclk-sample  = <1>;
            };
        };
    };
};

&amba_pl {
	/* 视频捕获设备 - 连接Camera到VDMA的S2MM通道 */
    vcap {
        compatible = "xlnx,video";
        dmas = <&axi_vdma_0 1>;  
        dma-names = "port0";

        ports {
            #address-cells = <1>;
            #size-cells = <0>;
                port@0 {
                reg = <0>;
                direction = "input";
                vcap_in: endpoint {
                    remote-endpoint = <&camera_out>;
                    /* Match OV9282 DVP 10-bit */
                    bus-width = <10>;
		    bus-type    = <5>;
                };
            };
        };
	};
};

/* SPI devices: BMI088 on spi0, ADXL372 on spi1 */
&axi_quad_spi_0 {
   status = "okay";

    spidev0@0 {
         compatible = "spidev";
         reg = <0>;
         spi-max-frequency = <10000000>;
     };

    spidev1@1 {
         compatible = "spidev";
         reg = <1>;
         spi-max-frequency = <10000000>;
     };
    /* BMI088 IMU attached to SPI chip-select 0 */
//    bmi088_accel@0 {
