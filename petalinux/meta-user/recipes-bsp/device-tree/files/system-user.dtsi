//        spi-max-frequency = <10000000>;
//        spi-cpol;
//        spi-cpha;
//        status = "okay";
//    };
};


&axi_quad_spi_1 {
    status = "okay";

    spidev2@0 {
         compatible = "spidev";
         reg = <0>;
         spi-max-frequency = <10000000>;
     };

    /* ADXL372 accelerometer attached to SPI chip-select 0 */
//    adxl372@0 {
//        compatible = "adi,adxl372";
//        reg = <0>;
//        spi-max-frequency = <20000000>;
//        status = "okay";
//    };
};

&video_mameger_1{
	interrupt-names = "vid2intc_irpt";
        interrupt-parent = <&intc>;
        interrupts = <0 29 1>;
};

&pinctrl0 {
	sdio1_default: sdio1-default {
            mux {
                groups = "sdio1_3_grp";
                function = "sdio1";
            };

            conf {
                groups = "sdio1_3_grp";
                bias-pull-up;
                low-power-enable;
		};
        };
	sdio1_cd_default: sdio1-cd-default{
		mux {
      			groups = "sdio1_emio_cd";
      			function = "sdio1_cd";
    		};
		conf {
			groups = "sdio1_emio_cd";
			low-power-enable;
		};
	};
};
&sdhci1 {
//    /* SDIO专用配置 */
    bus-width = <4>;                    /* 4位数据总线 */
    max-frequency = <50000000>;         /* 最大50MHz */
    non-removable;                      /* 非可移除设备 */
    xlnx,mio-bank = <1>;
//    xlnx,fails-without-test-cd;
    broken-cd;
    keep-power-in-suspend;
//    cap-sd-highspeed;                   /* 支持高速SD */
//    cap-mmc-highspeed;                  /* 支持高速MMC */
//    cap-sdio-irq;                       /* 支持SDIO中断 */
    disable-wp;                         /* 禁用写保护检测 */
    pinctrl-names = "default";
    pinctrl-0 = <&sdio1_default>;
//   
};

