#include "dt-bindings/gpio/gpio.h"
#include "dt-bindings/input/linux-event-codes.h"
/ {
    model = "DC";
	chosen {
		bootargs = "console=ttyPS0,115200 earlyprintk root=/dev/mmcblk0p2 rw rootwait debug";
		stdout-path = "serial0:115200n8";
	};

    usb_phy0: phy0@e0002000 {
		compatible = "ulpi-phy";
		#phy-cells = <0>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x0170>;
		drv-vbus;
	};
    cam_clk_24mhz: cam_clk_24mhz {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>; /* 24MHz */
                clock-output-names = "cam_clk_24mhz";
    };
	/* OV9282 专用固定电源：DOVDD 2.8V（数字I/O电压） */
    ov9282_dovdd_2v8: regulator-ov9282-dovdd {
        compatible = "regulator-fixed";  // 固定电压稳压器标识
        regulator-name = "OV9282_DOVDD_2V8";  // 电源名称（便于调试）
        regulator-min-microvolt = <2800000>;  // 最小电压：2.8V（转换为微伏）
        regulator-max-microvolt = <2800000>;  // 最大电压：2.8V（固定电压，与最小一致）
        regulator-boot-on;  // 系统启动时自动使能该电源
        regulator-always-on;  // 电源持续使能，避免摄像头掉电
    };

    /* OV9282 专用固定电源：AVDD 2.8V（模拟电压） */
    ov9282_avdd_2v8: regulator-ov9282-avdd {
        compatible = "regulator-fixed";
        regulator-name = "OV9282_AVDD_2V8";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        regulator-boot-on;
        regulator-always-on;
    };

    /* OV9282 专用固定电源：DVDD 1.5V（数字核心电压） */
    ov9282_dvdd_1v5: regulator-ov9282-dvdd {
        compatible = "regulator-fixed";
        regulator-name = "OV9282_DVDD_1V5";
        regulator-min-microvolt = <1500000>;  // 1.5V转换为微伏
        regulator-max-microvolt = <1500000>;
        regulator-boot-on;
        regulator-always-on;
    };
    leds {
        compatible = "gpio-leds";
        
        /* 第一个LED，使用GPIO0的第0个引脚 */
        led0 {
            label = "led0";
            gpios = <&axi_gpio_0 0 0 0>;  /* bank 0, 引脚0, 激活电平0 */
            linux,default-trigger = "heartbeat"; /* 可选：心跳效果 */
            max-brightness = <1>;
	    default-state = "on";
        };
        
        /* 第二个LED，使用GPIO0的第1个引脚 */
        led1 {
            label = "led1";
            gpios = <&axi_gpio_0 1 0 0>;  /* bank 0, 引脚1, 激活电平0 */
            linux,default-trigger = "mmc1"; /* 可选：心跳效果 */
	    max-brightness = <1>;
            default-state = "on";
        };
    };
};

// 1. 定义 pinctrl 控制器节点
